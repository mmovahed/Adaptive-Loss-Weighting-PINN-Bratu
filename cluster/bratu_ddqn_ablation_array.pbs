#!/bin/bash
#PBS -S /bin/bash
#PBS -q lumer
#PBS -N bratu_ddqn_abln
#PBS -l nodes=1:ppn=1
#PBS -l walltime=12:00:00
#PBS -t 0-39
#PBS -j oe
set -o pipefail

# 0..19 = original DDQN control, 20..39 = alpha+beta=2 treatment.
PROJECT_ROOT=${BRATU_PROJECT_ROOT:?Export BRATU_PROJECT_ROOT to your repository directory}
BASE=${BRATU_WORK_BASE:-$PROJECT_ROOT}
ENV=${BRATU_PYTHON_ENV:-$HOME/.conda/envs/bratu}
GLIBC=/share/Application/glibc/glibc-2.17/glibc-2.17/install
TORCHROOT=$BASE/bratu_torch151
TORCHLIB=$TORCHROOT/torch/lib
PY_PRIMARY=$BASE/runtime/python37_glibc217
PY_FALLBACK=$ENV/bin/python
if [ -x "$PY_PRIMARY" ]; then PY=$PY_PRIMARY;
elif [ -x "$PY_FALLBACK" ]; then PY=$PY_FALLBACK;
else echo 'ERROR: Cluster Python not found'; exit 127; fi
cd "$PROJECT_ROOT" || exit 2
ID="${PBS_ARRAYID:-${PBS_ARRAY_INDEX:-}}"
if [ -z "$ID" ] || [ "$ID" -lt 0 ] || [ "$ID" -gt 39 ]; then
    echo "ERROR: invalid PBS array index: $ID"; exit 2
fi
OUT="$PROJECT_ROOT/results/ddqn_ablation_v1/production/logs"
mkdir -p "$OUT"
LOG="$OUT/ablation_$(printf '%02d' "$ID").log"
export BRATU_TOTAL_PINN_STEPS=15000 BRATU_N_COLLOCATION=256 BRATU_N_VALIDATION=512
export BRATU_N_TEST=2000 BRATU_WARMUP_STEPS=200 BRATU_DECISION_INTERVAL=20
export BRATU_SELECTION_CANDIDATES=5 BRATU_DDQN_TRAIN_EPISODES=5
export BRATU_CANDIDATE_SEED_STRIDE=1000003 BRATU_LEARNING_RATE=0.001
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 MPLBACKEND=Agg

# IMPORTANT: scope custom glibc to Python, not to tee/bash/system tools.
PYTHONHOME="$ENV" \
PYTHONPATH="$TORCHROOT:$PROJECT_ROOT" \
LD_LIBRARY_PATH="$GLIBC/lib:$ENV/lib:$TORCHLIB:/usr/lib64:/lib64" \
"$PY" -u experiments/bratu_ddqn_ablation.py --index "$ID" 2>&1 | tee "$LOG"
RC=${PIPESTATUS[0]}
echo "ABLATION_JOB_END index=$ID exit_code=$RC hostname=$(hostname)" | tee -a "$LOG"
exit "$RC"
