#!/bin/bash
#PBS -S /bin/bash
#PBS -q lumer
#PBS -N bratu_branch_collect
#PBS -l nodes=1:ppn=1
#PBS -l walltime=00:30:00
#PBS -j oe
set -u
PROJECT_ROOT=${BRATU_PROJECT_ROOT:?Export BRATU_PROJECT_ROOT to your repository directory}
BASE=${BRATU_WORK_BASE:-$PROJECT_ROOT}
ENV=${BRATU_PYTHON_ENV:-$HOME/.conda/envs/bratu}
GLIBC=/share/Application/glibc/glibc-2.17/glibc-2.17/install
PY_PRIMARY=$BASE/runtime/python37_glibc217
TORCHROOT=$BASE/bratu_torch151
TORCHLIB=$TORCHROOT/torch/lib
cd "$PROJECT_ROOT" || exit 2
if [ -x "$PY_PRIMARY" ]; then PY="$PY_PRIMARY"; else PY="$ENV/bin/python"; fi
PYTHONHOME="$ENV" PYTHONPATH="$TORCHROOT:$PROJECT_ROOT" LD_LIBRARY_PATH="$GLIBC/lib:$ENV/lib:$TORCHLIB:/usr/lib64:/lib64" \
OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 "$PY" analysis/collect_branch_audit.py
